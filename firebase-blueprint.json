{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private user account profile storing customer or vendor login path and location preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "portalType": {
          "type": "string",
          "enum": ["client", "provider"]
        },
        "neighborhood": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "portalType",
        "neighborhood",
        "lat",
        "lng",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProviderProfile": {
      "title": "ProviderProfile",
      "description": "Public directory profile for a certified local service vendor.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 300
        },
        "trade": {
          "type": "string",
          "enum": ["Electrical", "Plumbing", "Appliance Repair", "Cleaning"]
        },
        "trainingDays": {
          "type": "number"
        },
        "certificateId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32,
          "pattern": "^(SOFTI|CB)-[0-9]{4}-[A-Z]{2}-[0-9]{3,5}$"
        },
        "trainingCenter": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "practicalScore": {
          "type": "number"
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["pending", "verified", "revoked"]
        },
        "isAvailable": {
          "type": "boolean"
        },
        "hourlyRate": {
          "type": "number"
        },
        "completedJobs": {
          "type": "number"
        },
        "rating": {
          "type": "number"
        },
        "zoneName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "bio": {
          "type": "string",
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "trade",
        "trainingDays",
        "certificateId",
        "trainingCenter",
        "practicalScore",
        "verificationStatus",
        "isAvailable",
        "hourlyRate",
        "completedJobs",
        "rating",
        "zoneName",
        "lat",
        "lng",
        "createdAt",
        "updatedAt"
      ]
    },
    "PracticalCertificate": {
      "title": "PracticalCertificate",
      "description": "Public verification record for mandatory practical training completion.",
      "type": "object",
      "properties": {
        "certId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32,
          "pattern": "^(SOFTI|CB)-[0-9]{4}-[A-Z]{2}-[0-9]{3,5}$"
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "holderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "trade": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "trainingDays": {
          "type": "number"
        },
        "practicalScore": {
          "type": "number"
        },
        "centerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "modulesCompleted": {
          "type": "array"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "verified", "revoked"]
        },
        "issuedDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30
        },
        "verifiedBy": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "certId",
        "providerId",
        "holderName",
        "trade",
        "trainingDays",
        "practicalScore",
        "centerName",
        "modulesCompleted",
        "status",
        "issuedDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Customer service job request with photos, description, and budget range within 10-15 km.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "providerId": {
          "type": "string",
          "maxLength": 128
        },
        "providerName": {
          "type": "string",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        },
        "trade": {
          "type": "string",
          "enum": ["Electrical", "Plumbing", "Appliance Repair", "Cleaning"]
        },
        "urgency": {
          "type": "string",
          "enum": ["standard", "same_day", "emergency"]
        },
        "zoneName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "maxRadiusKm": {
          "type": "number"
        },
        "budgetMin": {
          "type": "number"
        },
        "budgetMax": {
          "type": "number"
        },
        "estimatedBudget": {
          "type": "number"
        },
        "photos": {
          "type": "array"
        },
        "contactPreview": {
          "type": "string",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["open", "accepted", "in_progress", "completed", "cancelled"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["unpaid", "escrow_held", "released"]
        },
        "paymentTxnId": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "clientId",
        "clientName",
        "providerId",
        "providerName",
        "title",
        "description",
        "trade",
        "urgency",
        "zoneName",
        "lat",
        "lng",
        "maxRadiusKm",
        "budgetMin",
        "budgetMax",
        "estimatedBudget",
        "photos",
        "contactPreview",
        "status",
        "paymentStatus",
        "paymentTxnId",
        "createdAt",
        "updatedAt"
      ]
    },
    "RequestContactDetails": {
      "title": "RequestContactDetails",
      "description": "PII-isolated customer contact phone and street address unlocked to assigned vendor.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "contactPhone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "contactAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "preferredWindow": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requestId",
        "clientId",
        "contactPhone",
        "contactAddress",
        "createdAt",
        "updatedAt"
      ]
    },
    "EscrowPayment": {
      "title": "EscrowPayment",
      "description": "Verified escrow payment and release transaction record between customer and vendor.",
      "type": "object",
      "properties": {
        "txnId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 40,
          "pattern": "^TXN-[A-Z0-9\\-]+$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "providerId": {
          "type": "string",
          "maxLength": 128
        },
        "amount": {
          "type": "number"
        },
        "platformFee": {
          "type": "number"
        },
        "providerPayout": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "enum": ["upi", "card", "netbanking", "wallet"]
        },
        "status": {
          "type": "string",
          "enum": ["escrow_held", "released"]
        },
        "receiptHash": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "txnId",
        "requestId",
        "clientId",
        "providerId",
        "amount",
        "platformFee",
        "providerPayout",
        "method",
        "status",
        "receiptHash",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account records isolated to the owning user or admin."
    },
    "/providers/{providerId}": {
      "schema": { "$ref": "#/entities/ProviderProfile" },
      "description": "Public directory of practically certified local service vendors."
    },
    "/certificates/{certId}": {
      "schema": { "$ref": "#/entities/PracticalCertificate" },
      "description": "Real-time practical training certificate verification registry."
    },
    "/serviceRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ServiceRequest" },
      "description": "Customer service requests with photos and budget ranges dispatched within 10-15 km."
    },
    "/serviceRequests/{requestId}/contactDetails/{detailId}": {
      "schema": { "$ref": "#/entities/RequestContactDetails" },
      "description": "PII-isolated customer phone and address unlocked to the assigned vendor."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/EscrowPayment" },
      "description": "Private escrow payment records accessible only to transaction participants and admin."
    }
  }
}
